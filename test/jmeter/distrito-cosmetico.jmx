try {
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (json.ok != true) throw new AssertionError('ok != true')
if (json.service == null) throw new AssertionError('Missing service')
vars.put('service', String.valueOf(json.service))
} catch (Throwable error) { prev.setSuccessful(false); prev.setResponseMessage('JSON validation: ' + error.getMessage()) }
