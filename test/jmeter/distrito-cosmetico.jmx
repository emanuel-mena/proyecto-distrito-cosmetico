try {
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (json.ok != true) throw new AssertionError('ok != true')
if (json.user.id == null) throw new AssertionError('Missing clientId')
vars.put('clientId', String.valueOf(json.user.id))
if (json.token == null) throw new AssertionError('Missing clientToken')
vars.put('clientToken', String.valueOf(json.token))
} catch (Throwable error) { prev.setSuccessful(false); prev.setResponseMessage('JSON validation: ' + error.getMessage()) }
