          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validate and extract JSON" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
try {
  def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
  if (json.ok != true) throw new AssertionError(&apos;ok != true&apos;)
  if (!json.data?._id || !(json.data.items instanceof List)) throw new AssertionError(&apos;cart missing&apos;)
  vars.put(&apos;cartId&apos;, String.valueOf(json.data._id))
  vars.put(&apos;cartItemCount&apos;, String.valueOf(json.data.items.size()))
} catch (Throwable e) { prev.setSuccessful(false); prev.setResponseMessage(&apos;JSON: &apos; + e.getMessage()) }</stringProp>
            <stringProp name="parameters"></stringProp>
